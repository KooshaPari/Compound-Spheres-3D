<Project Sdk="Microsoft.NET.Sdk">
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <Version>1.0.2</Version>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <LangVersion>8.0</LangVersion>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    
    <!-- NuGet package metadata -->
    <PackageId>CompoundMeshes</PackageId>
    <Authors>KooshaPari</Authors>
    <Company>Phenotype</Company>
    <Description>Compound Spheres: high-efficiency compound mesh rendering for Unity. Displays 2D grids on 3D objects with GPU-accelerated sphere management, height-field rendering, and frustum culling.</Description>
    <PackageTags>unity;3d;mesh;compound;spheres;gpu;heightfield;frustum</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/KooshaPari/Compound-Spheres-3D</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/KooshaPari/Compound-Spheres-3D</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <PropertyGroup>
    <WorldBoxPath Condition="'$(WorldBoxPath)' == '' AND '$(WORLDBOX_PATH)' != ''">$(WORLDBOX_PATH)</WorldBoxPath>
    <WorldBoxPath Condition="'$(WorldBoxPath)' == '' AND '$(OS)' == 'Windows_NT'">C:/Program Files (x86)/Steam/steamapps/common/worldbox</WorldBoxPath>
    <WorldBoxManaged>$(WorldBoxPath)/worldbox_Data/Managed</WorldBoxManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(WorldBoxManaged)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
